# BlackRoad API example overrides
# Copy to srv/blackroad-api/.env and adjust as needed.

# ---- Required ----
SESSION_SECRET=change-me-in-production
INTERNAL_TOKEN=change-me-in-production
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database ----
DB_PATH=./blackroad.db

# ---- LLM / Math engine ----
LLM_URL=http://127.0.0.1:8000/chat
MATH_ENGINE_URL=

# ---- Feature flags ----
ALLOW_SHELL=false
BILLING_DISABLE=false
BYPASS_LOGIN=false
DEBUG_MODE=false
FLAGS_PARAM=/blackroad/dev/flags
FLAGS_MAX_AGE_MS=30000

# ---- Git branches ----
BRANCH_MAIN=main
BRANCH_STAGING=staging

# ---- Stripe (billing) ----
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# ---- Integrations (all optional) ----
AIRTABLE_API_KEY=
DISCORD_INVITE=
GITHUB_WEBHOOK_SECRET=
GOOGLE_CALENDAR_CREDENTIALS=
GSHEETS_SA_JSON=
GUMROAD_TOKEN=
ICS_URL=
LINEAR_API_KEY=
MAIL_PROVIDER=
SF_USERNAME=
SHEETS_CONNECTOR_TOKEN=
SLACK_WEBHOOK_URL=
SUBSCRIBE_MODE=

# ---- Infrastructure / mesh ----
IPFS_API=http://127.0.0.1:5001
TRUTH_TOPIC=truth.garden/v1/announce
BACKPLANE_URL=http://127.0.0.1:4000
LED_DEVICE_ID=pi-01
TRUTH_PIN_CONCURRENCY=2
