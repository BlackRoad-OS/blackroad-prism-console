# BlackRoad API - Environment Configuration
# Copy this file to srv/blackroad-api/.env and adjust as needed.

# ==========================================
# CORE SERVER CONFIGURATION
# ==========================================

# Server port (default: 4000)
PORT=4000

# Session secret for cookie-based authentication (REQUIRED in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=dev-secret-change-me

# Internal API token for service-to-service communication (REQUIRED in production)
INTERNAL_TOKEN=change-me

# Node environment (development, test, production)
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Path to SQLite database file (default: /srv/blackroad-api/blackroad.db)
# Use ':memory:' for in-memory database (testing only)
DB_PATH=./blackroad.db

# Disable native database (for testing or when better-sqlite3 is unavailable)
# Values: true, false, 1, 0
BR_TEST_DISABLE_DB=false
BRC_DISABLE_NATIVE_DB=false

# ==========================================
# LLM & AI SERVICES
# ==========================================

# LLM service URL (default: http://127.0.0.1:8000/chat)
LLM_URL=http://127.0.0.1:8000/chat

# LLM API key (if required by your LLM provider)
# LLM_API_KEY=

# ==========================================
# EXTERNAL INTEGRATIONS
# ==========================================

# IPFS API endpoint for distributed storage
IPFS_API=http://127.0.0.1:5001

# Truth Garden topic for announcements
TRUTH_TOPIC=truth.garden/v1/announce

# Backplane service URL for distributed coordination
BACKPLANE_URL=http://127.0.0.1:4000

# IoT device identifiers
LED_DEVICE_ID=pi-01

# Concurrency limit for truth pinning operations
TRUTH_PIN_CONCURRENCY=2

# ==========================================
# STRIPE BILLING (if billing enabled)
# ==========================================

# Stripe secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET=

# Stripe webhook signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# ==========================================
# FEATURE FLAGS
# ==========================================

# Disable billing features (default: false)
BILLING_DISABLE=false

# Allow shell command execution (default: false, enable with caution)
ALLOW_SHELL=false

# ==========================================
# CORS & SECURITY
# ==========================================

# Allowed CORS origins (comma-separated list)
# Example: http://localhost:5173,http://localhost:3000,https://yourdomain.com
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# STATIC FILE SERVING
# ==========================================

# Root directory for serving static web files
WEB_ROOT=/var/www/blackroad

# ==========================================
# LOGGING & MONITORING
# ==========================================

# Log level (silent, error, warn, info, debug)
LOG_LEVEL=info

# Custom .env file path (if not using default)
# DOTENV_PATH=

# ==========================================
# OPTIONAL INTEGRATIONS
# ==========================================

# Google Calendar API credentials (if using calendar features)
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=

# Linear API key (if using Linear integration)
# LINEAR_API_KEY=

# GitHub API token (if using GitHub integration)
# GITHUB_TOKEN=

# Slack webhook URL (if using Slack notifications)
# SLACK_WEBHOOK_URL=

# ==========================================
# DEVELOPMENT & TESTING
# ==========================================

# Enable development mode features
# DEV_MODE=true

# Disable SSL verification (development only, never use in production)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Mock external services (testing only)
# MOCK_EXTERNAL_SERVICES=true

# ==========================================
# NOTES
# ==========================================

# Required variables in production:
# - SESSION_SECRET (must be secure, min 32 characters)
# - INTERNAL_TOKEN (must be secure)
# - ALLOW_ORIGINS (must specify trusted domains)

# Security reminders:
# - Never commit this file with real secrets
# - Use strong, randomly generated values for secrets
# - Rotate secrets regularly in production
# - Set ALLOW_SHELL=false in production
# - Verify ALLOW_ORIGINS only includes trusted domains

# Performance tips:
# - Use DB_PATH pointing to SSD for better performance
# - Adjust TRUTH_PIN_CONCURRENCY based on your workload
# - Monitor LLM_URL response times

# Troubleshooting:
# - If database fails, check DB_PATH permissions
# - If LLM features fail, verify LLM_URL is reachable
# - If CORS errors occur, check ALLOW_ORIGINS configuration
# - Set LOG_LEVEL=debug for detailed troubleshooting

