# BlackRoad API example overrides
# Copy to srv/blackroad-api/.env and adjust as needed.
PORT=4000
DB_PATH=./blackroad.db
LLM_URL=http://127.0.0.1:4010
# Port 4010 = ollama-bridge.js — a lightweight Express proxy that forwards
# OpenAI-compatible requests to Ollama at OLLAMA_URL. Use this when the API
# server needs an OpenAI-compatible endpoint; or set LLM_URL=http://127.0.0.1:11434
# to call Ollama directly (requires /api/chat path in your client).
# Ollama base URL (used by the ollama-bridge and direct integrations)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
IPFS_API=http://127.0.0.1:5001
TRUTH_TOPIC=truth.garden/v1/announce
BACKPLANE_URL=http://127.0.0.1:4000
LED_DEVICE_ID=pi-01
TRUTH_PIN_CONCURRENCY=2
