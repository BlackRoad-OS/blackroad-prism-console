# ============================================================================
# BLACKROAD PRISM CONSOLE - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and customize for your environment
# Services will use these variables or fall back to defaults

# ============================================================================
# GLOBAL / INFRASTRUCTURE
# ============================================================================
REGISTRY=ghcr.io/blackboxprogramming
IMAGE_TAG=latest
ENVIRONMENT=development
NODE_ENV=development
LOG_LEVEL=info
DEBUG=false

# ============================================================================
# PRISM CONSOLE API (services/prism-console-api/)
# ============================================================================
PRISM_API_PORT=4000
PRISM_API_DB_URL=sqlite:///prism.db
PRISM_API_LOG_LEVEL=info
PRISM_API_MOCK_MODE=false
PRISM_API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth configuration (set mock_mode=true for local dev without auth)
PRISM_API_AUTH_ISSUER_URL=https://auth.blackroad.io
PRISM_API_AUTH_AUDIENCE=prism-console-api

# Runbook execution (external workflow engine URL)
PRISM_API_RUNBOOK_WORKFLOW_URL=http://localhost:8088

# ============================================================================
# PRISM CONSOLE WEB (apps/prism-console-web/)
# ============================================================================
# Base URL for Prism Console API (falls back to mocks if not set)
BLACKROAD_API_URL=http://localhost:4000
BLACKROAD_API_TOKEN=

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000

# ============================================================================
# ROADCHAIN SERVICE (services/roadchain/)
# ============================================================================
# NOTE: This service is currently a prototype with ephemeral in-memory state
# For production use, integrate with external roadchain node
ROADCHAIN_PORT=4221
ROADCHAIN_REDIS_URL=redis://localhost:6379
ROADCHAIN_LOG_LEVEL=info
ROADCHAIN_BLOCK_TIME=10
ROADCHAIN_MIN_STAKE=1000

# ============================================================================
# AUTH SERVICE (services/auth/)
# ============================================================================
AUTH_PORT=4100
AUTH_ISSUER_URL=http://localhost:4100
AUTH_DB_URL=sqlite:///auth.db
AUTH_JWT_SECRET=change-me-in-production-use-strong-secret
AUTH_JWT_EXPIRY=3600

# ============================================================================
# LUCIDIA API (services/lucidia_api/)
# ============================================================================
LUCIDIA_API_PORT=4200
LUCIDIA_API_LOG_LEVEL=info

# ============================================================================
# QUANTUM COPILOT (services/quantum_copilot/)
# ============================================================================
QUANTUM_COPILOT_PORT=4300
QISKIT_API_TOKEN=

# ============================================================================
# AUTOPAL (services/autopal/)
# ============================================================================
AUTOPAL_PORT=4400
AUTOPAL_DB_URL=sqlite:///autopal.db

# ============================================================================
# AGENT GATEWAY (apps/agent-gateway/)
# ============================================================================
AGENT_GATEWAY_PORT=3001

# ============================================================================
# BLACKROAD OS AGENT (blackroad-os/)
# ============================================================================
BLACKROAD_AGENT_CONFIG_PATH=config/default.yaml
BLACKROAD_AGENT_MQTT_BROKER=mqtt://localhost:1883
BLACKROAD_AGENT_API_URL=http://localhost:4000

# ============================================================================
# PI CORTEX STACK (pi-cortex-stack/)
# ============================================================================
PI_CORTEX_MQTT_BROKER=mqtt://localhost:1883
PI_CORTEX_API_URL=http://localhost:4000

# ============================================================================
# SHARED INFRASTRUCTURE
# ============================================================================

# Database (for services using shared postgres instead of sqlite)
DATABASE_URL=postgresql://blackroad:password@localhost:5432/blackroad

# Redis (for caching, queues, pub/sub)
REDIS_URL=redis://localhost:6379

# MQTT Broker (for agent/device telemetry)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Observability
OTLP_ENDPOINT=
METRICS_AUTH_TOKEN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# ============================================================================
# EXTERNAL SERVICES (cloud/external providers)
# ============================================================================

# Quantum Hardware (IBM Quantum)
QISKIT_API_TOKEN=

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External Ledger/Blockchain
ETHEREUM_RPC_URL=
ETHEREUM_PRIVATE_KEY=

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================
ENABLE_MOCKS=true
BUILD_SHA=local
APP_NAME=blackroad-prism-console
READINESS_DEPENDENCIES=
# FILE: /srv/blackroad-api/.env
NODE_ENV=production
PORT=4000
DB_PATH=/srv/blackroad-api/blackroad.db

# RoadView storage directory (overrides default if set)
ROADVIEW_STORAGE=/srv/blackroad-api/storage/roadview

# Cookies & JWT
SESSION_SECRET=change-this-session-secret
JWT_SECRET=change-this-jwt-secret
SOCKET_SECRET=change-this-socket-secret

# CORS
ALLOWED_ORIGIN=https://blackroad.io

# Bootstrap admin (change immediately in production)
ADMIN_EMAIL=root@blackroad.io
ADMIN_PASSWORD=Codex2025
ADMIN_NAME=Root

# Optional routes
ENABLE_EXEC_ROUTES=false

# LLM bridge
LUCIDIA_LLM_URL=http://127.0.0.1:8000

# Deploy webhook
DEPLOY_WEBHOOK_SECRET=change-this-deploy-secret
ALLOW_DEPLOY_RUN=false

# Logging
LOG_DIR=/var/log/blackroad-api
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
# Lucidia serving/training
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_MODEL=lucidia-neox-1.4b
RAG_INDEX_PATH=rag/index/lucidia.faiss
TRAIN_BASE_MODEL=EleutherAI/pythia-1.4b

# Billing (Stripe)
APP_URL=https://blackroad.io
API_URL=https://blackroad.io/api
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# -- Creator plan Stripe price IDs
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=
# -- Pro plan Stripe price IDs
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
# -- Enterprise plan Stripe price IDs
STRIPE_PRICE_ENTERPRISE_MONTH=
STRIPE_PRICE_ENTERPRISE_YEAR=
# -- Drive add-on Stripe price IDs
STRIPE_PRICE_DRIVE_MONTH=
STRIPE_PRICE_DRIVE_YEAR=
BILLING_RETURN_URL=https://blackroad.io/subscribe
BILLING_CANCEL_URL=https://blackroad.io/subscribe?canceled=1
# -- Plan prices in cents (used for fallback / display)
PRICE_CREATOR_MONTH_CENTS=900
PRICE_CREATOR_YEAR_CENTS=9000
PRICE_PRO_MONTH_CENTS=2900
PRICE_PRO_YEAR_CENTS=29000
PRICE_ENTERPRISE_MONTH_CENTS=49900
PRICE_ENTERPRISE_YEAR_CENTS=499000
PRICE_DRIVE_MONTH_CENTS=499
PRICE_DRIVE_YEAR_CENTS=4990
BILLING_DISABLE=false
OPENAI_API_KEY=
DATABASE_URL=postgres://prism:prism@localhost:5432/prism # pragma: allowlist secret
S3_BUCKET=prism-artifacts
PRISM_RUN_ALLOW=node
# Core
PORT=HTTP port for the BlackRoad API server and Unity exporter (integer, default 4000 for API / 3000 for Unity)
SESSION_SECRET=Secret used to encrypt session cookies (32+ random characters)
INTERNAL_TOKEN=Shared service token for internal API access and agents (string)
ALLOW_ORIGINS=Comma-separated list of allowed CORS origins (e.g. https://app.example.com)

# API
DB_PATH=(optional) Absolute path to the SQLite database for the API (default /srv/blackroad-api/blackroad.db)
LLM_URL=URL for the Lucidia LLM chat endpoint used by the API (http/https URL)
MATH_ENGINE_URL=(optional) URL for the math/analytics engine (http/https URL)
ALLOW_SHELL=(optional) Set to true to enable shell execution features (true/false)
WEB_ROOT=(optional) Filesystem path to static assets served by the API (default /var/www/blackroad)
BILLING_DISABLE=(optional) Set true to disable billing and Stripe flows (true/false)
DEBUG_MODE=(optional) Enables verbose debug probes when true (true/false)
DEBUG_PROBES=(optional) Legacy debug probe flag, treated the same as DEBUG_MODE (true/false)
BYPASS_LOGIN=(optional) Allow login bypass for local development (true/false)
FLAGS_PARAM=(optional) Feature flag configuration key or path (string)
FLAGS_MAX_AGE_MS=(optional) Milliseconds to cache feature flags (integer)
GITHUB_WEBHOOK_SECRET=(optional) Secret used to verify inbound GitHub webhooks (string)
BRANCH_MAIN=(optional) Name of the primary branch for deploy workflows (default main)
BRANCH_STAGING=(optional) Name of the staging branch for deploy workflows (default staging)
AIRTABLE_API_KEY=(optional) Airtable API key for integrations (string)
DISCORD_INVITE=(optional) Invite URL for Discord integration (https URL)
GOOGLE_CALENDAR_CREDENTIALS=(optional) Google Calendar service account JSON (base64 or raw JSON)
GSHEETS_SA_JSON=(optional) Google Sheets service account JSON payload (base64 or raw JSON)
GUMROAD_TOKEN=(optional) Gumroad API token for commerce integrations (string)
ICS_URL=(optional) External ICS feed URL for calendar sync (https URL)
LINEAR_API_KEY=(optional) Linear API key used by the dashboard (string)
MAIL_PROVIDER=(optional) Mail provider identifier (e.g. sendgrid) for transactional email
NODE_ENV=(optional) Node.js environment indicator (development/production)
PRICE_CREATOR_MONTH_CENTS=(optional) Creator monthly plan price in cents (integer, default 900)
PRICE_CREATOR_YEAR_CENTS=(optional) Creator annual plan price in cents (integer, default 9000)
PRICE_PRO_MONTH_CENTS=(optional) Pro monthly plan price in cents (integer, default 2900)
PRICE_PRO_YEAR_CENTS=(optional) Pro annual plan price in cents (integer, default 29000)
PRICE_ENTERPRISE_MONTH_CENTS=(optional) Enterprise monthly plan price in cents (integer, default 49900)
PRICE_ENTERPRISE_YEAR_CENTS=(optional) Enterprise annual plan price in cents (integer, default 499000)
PRICE_DRIVE_MONTH_CENTS=(optional) Drive add-on monthly price in cents (integer, default 499)
PRICE_DRIVE_YEAR_CENTS=(optional) Drive add-on annual price in cents (integer, default 4990)
SF_USERNAME=(optional) Salesforce integration username (string)
SHEETS_CONNECTOR_TOKEN=(optional) Token for Sheets connector bridge (string)
SLACK_WEBHOOK_URL=(optional) Slack webhook for operational alerts (https URL)
STRIPE_SECRET=(optional) Stripe secret key for billing (sk_live... or sk_test...)
STRIPE_WEBHOOK_SECRET=(optional) Stripe webhook signing secret (whsec_...)
STRIPE_PUBLIC_KEY=(optional) Stripe publishable key for frontend usage (pk_live...)
SUBSCRIBE_MODE=(optional) Subscription mode override (e.g. sandbox) for billing flows

# LLM
LUCIDIA_MODEL=(optional) HuggingFace model identifier for Lucidia (e.g. meta-llama/Meta-Llama-3-8B-Instruct)
LUCIDIA_USE_MODEL=(optional) Set to 1 to enable loading the configured model (0/1)

# Unity
# Unity exporter reuses PORT from the Core section.
UNITY_EXPORTER_OUTPUT_DIR=(optional) Directory to place generated Unity project archives

# CI/CD (define these as GitHub Actions secrets; optional for local development)
APPLE_TEAM_ID=(optional) Apple developer team identifier for iOS workflows
ASANA_WEBHOOK_URL=(optional) Webhook URL for Asana notifications
ASC_ISSUER_ID=(optional) App Store Connect issuer ID for iOS distribution
ASC_KEY_CONTENT=(optional) App Store Connect API key content (base64 or raw key)
ASC_KEY_ID=(optional) App Store Connect API key identifier
AUTOPAL_BREAK_GLASS_SECRET=(optional) Emergency override secret for Autopal automation
AWAKEN_SEED=(optional) Seed phrase or token for Awaken integration
AWS_ROLE_TO_ASSUME=(optional) AWS IAM role ARN assumed by deployment workflows
BACKUP_PASSPHRASE=(optional) Encryption passphrase for backup archives
BILLING_EXPORT_URL=(optional) Destination URL for billing export workflows
BOT_TOKEN=(optional) Bot access token used by automation bots
BOT_USER=(optional) Bot username or ID for automation workflows
BRANCH_CLEANUP_TOKEN=(optional) Token used by branch cleanup automation
BR_DEPLOY_SECRET=(optional) Deployment secret for BlackRoad infrastructure
BR_DEPLOY_URL=(optional) Deployment API endpoint for BlackRoad infrastructure
BR_HOST=(optional) SSH host for BlackRoad deployments
BR_SSH_KEY=(optional) Private SSH key for BlackRoad deployments
BR_USER=(optional) SSH username for BlackRoad deployments
CF_API_TOKEN=(optional) Cloudflare API token for DNS/CDN automation
CF_ZONE_ID=(optional) Cloudflare zone identifier for managed domain
CHANGE_APPROVAL_SECRET=(optional) Shared secret to approve change workflows
CLICKUP_WEBHOOK_URL=(optional) Webhook endpoint for ClickUp notifications
COINBASE_BITCOIN=(optional) Coinbase credential for bitcoin treasury checks
DATABASE_URL=(optional) Database URL for data workflows (postgres://, mysql:// etc.)
DEPLOY_HOST=(optional) Generic deploy host used by legacy workflows
DEPLOY_KEY=(optional) Private key used for generic deployments
DEPLOY_PORT=(optional) SSH port for generic deployments (integer)
DEPLOY_USER=(optional) SSH username for generic deployments
DISCORD_WEBHOOK_URL=(optional) Discord webhook for alerts
DOCKER_PAT=(optional) Personal access token for Docker registry access
DOCKER_USER=(optional) Docker registry username
DROPLET_HOST=(optional) Legacy droplet host for deployments
DROPLET_IP=(optional) Droplet IP address for provisioning workflows
DROPLET_SSH_KEY=(optional) SSH key for droplet deployments
DROPLET_USER=(optional) SSH username for droplet deployments
FINANCE_CSV_URL=(optional) URL containing finance CSV exports
FINOPS_BUDGET_JSON=(optional) JSON payload describing finops budget thresholds
GEMINI_SOLANA=(optional) Gemini credential used for Solana treasury tasks
GITGUARDIAN_API_KEY=(optional) GitGuardian API key for secret scanning
GITHUB_PAT=(optional) Personal access token for GitHub automation
GITHUB_TOKEN=(optional) Fine-grained GitHub token for workflows
GODADDY_API_KEY=(optional) GoDaddy API key for DNS automation
GODADDY_API_SECRET=(optional) GoDaddy API secret for DNS automation
HF_TOKEN=(optional) Hugging Face token for model downloads
HUBSPOT_TOKEN=(optional) HubSpot API token for CRM workflows
JIRA_BASE=(optional) Base URL of the Jira instance (https://...)
JIRA_PROJECT=(optional) Key of the Jira project targeted by workflows
JIRA_TOKEN=(optional) Jira API token for automation
JIRA_USER=(optional) Jira user email used with the API token
KUBE_CONFIG_B64=(optional) Base64 encoded kubeconfig for cluster deployments
LINEAR_TEAM=(optional) Linear team identifier for project sync
LINEAR_TOKEN=(optional) Linear API token for workflow automation
MATOMO_ENDPOINT=(optional) Matomo analytics endpoint for reporting
NOTION_TOKEN=(optional) Notion integration token for workspace automation
NPM_TOKEN=(optional) npm registry token for package publishing
OKTA_CLIENT_SECRET=(optional) Okta OAuth client secret for identity workflows
OKTA_TOKEN=(optional) Okta API token for user management
OKTA_URL=(optional) Base URL of the Okta tenant (https://...)
OP_SA_TOKEN=(optional) 1Password service account token for secret fetch
ORCHESTRATOR_TOKEN=(optional) Token for internal orchestrator workflows
PARTNER_REVIEW_SLACK_WEBHOOK=(optional) Slack webhook for partner review notifications
PD_ROUTING_KEY_SMOKE=(optional) PagerDuty routing key for smoke tests
PG_URL_DEV=(optional) Development Postgres URL for data workflows
PREVIEW_ENV_AWS_ROLE=(optional) AWS IAM role for preview environment deployments
PREVIEW_ENV_CLUSTER_ARN=(optional) ECS/EKS cluster ARN for preview deployments
PREVIEW_ENV_ECR_REGISTRY=(optional) AWS ECR registry URL for preview builds
PREVIEW_ENV_ECR_REPOSITORY=(optional) AWS ECR repository name for preview builds
PREVIEW_ENV_EXECUTION_ROLE_ARN=(optional) Task execution role ARN for preview services
PREVIEW_ENV_HOSTED_ZONE_ID=(optional) Route53 hosted zone ID for preview domains
PREVIEW_ENV_PRIVATE_SUBNET_IDS=(optional) Comma-separated private subnet IDs for preview infrastructure
PREVIEW_ENV_PUBLIC_SUBNET_IDS=(optional) Comma-separated public subnet IDs for preview infrastructure
PREVIEW_ENV_SECRETS_JSON=(optional) JSON string with preview environment runtime secrets
PREVIEW_ENV_TASK_ROLE_ARN=(optional) Task role ARN for preview services
PREVIEW_ENV_TF_LOCK_TABLE=(optional) DynamoDB table name for Terraform state locking
PREVIEW_ENV_TF_STATE_BUCKET=(optional) S3 bucket name for preview Terraform state
PREVIEW_ENV_VARS_JSON=(optional) JSON string of environment variables for preview tasks
PREVIEW_ENV_VPC_ID=(optional) VPC ID used by preview infrastructure
PROM_URL=(optional) Prometheus endpoint URL for monitoring workflows
PUBLIC_API_KEY=(optional) Public API key required by external integrations
PYPI_TOKEN=(optional) PyPI API token for publishing Python packages
REDIS_URL=(optional) Redis connection string for cache-related workflows
REGISTRY_TOKEN=(optional) Token for container registry pushes
REGISTRY_USER=(optional) Username for container registry pushes
ROBINHOOD_ETHEREUM=(optional) Robinhood credential used for ethereum treasury tasks
SALESFORCE_TOKEN=(optional) Salesforce API token for CRM workflows
SALESFORCE_URL=(optional) Salesforce instance base URL (https://...)
SLACK_BOT_TOKEN=(optional) Slack bot token for automation
SLACK_PREVIEW_CHANNEL=(optional) Slack channel ID used for preview notifications
SLACK_WEBHOOK=(optional) Slack webhook used by general workflows
SLACK_WEBHOOK_EXEC=(optional) Slack webhook for exec updates
SLACK_WEBHOOK_SMOKE=(optional) Slack webhook for smoke test alerts
SMTP_URL=(optional) SMTP connection string for email workflows
SNYK_TOKEN=(optional) Snyk API token for security scans
SOPS_AGE_KEY_FILE=(optional) Age key file content for SOPS decryption
SSH_PRIVATE_KEY=(optional) Generic SSH private key used across workflows
STAGING_URL=(optional) URL of the staging environment for smoke tests
STRIPE_SECRET_KEY=(optional) Stripe secret key for revenue reporting workflows
STRIPE_TEST_KEY=(optional) Stripe test key for sandbox validation
TELEMETRY_TOKEN=(optional) Token for telemetry collection agents
TWILIO_FROM=(optional) Twilio sending phone number for alerts
TWILIO_SID=(optional) Twilio account SID for messaging workflows
TWILIO_TOKEN=(optional) Twilio auth token for messaging workflows
VENMO_LITECOIN=(optional) Venmo credential used for litecoin treasury tasks
VERCEL_ORG_ID=(optional) Vercel organization ID for preview deployments
VERCEL_PROJECT_ID=(optional) Vercel project ID for preview deployments
VERCEL_TOKEN=(optional) Vercel access token for deployments
WAREHOUSE_TOKEN=(optional) Data warehouse API token for analytics workflows
WAREHOUSE_URL=(optional) Data warehouse endpoint URL for analytics workflows
WEBHOOK_SIGNING_SECRET=(optional) Secret used to verify inbound webhook payloads
WEBPUSH_PRIVATE_KEY=(optional) VAPID private key for web push notifications
WEBPUSH_PUBLIC_KEY=(optional) VAPID public key for web push notifications

# Agents
AGENTS_INTERNAL_TOKEN=(optional) Override token used by agent runtime (defaults to INTERNAL_TOKEN when unset)
# Okta SSO
OKTA_ISSUER=https://{yourOktaDomain}
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_REDIRECT_URI=https://blackroad.io/api/auth/okta/callback

# Data warehouse
WAREHOUSE_URL=
WAREHOUSE_TOKEN=
# Node environment
NODE_ENV=development
# Port the app listens on
PORT=3000
# Database connection string
DATABASE_URL=postgres://prism:prism@db:5432/prism
# Secret key for JWT signing
JWT_SECRET=change_me
